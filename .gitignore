# Python cache and local build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE and editor state
.idea/
*.swp
*.swo

# Local application state
temp_loaded_data.json

# Local agent/tool state (session screenshots and scratch files)
.openchamber/

# Generated reports and temporary files
test_results/**
!test_results/.gitkeep
# Generated baseline samples (local-only artifacts, never force-add)
baseline/collected/**
# Local archive of generated samples (never force-add)
archive/
temp/
/temp
*.log
logs/

# Runtime measurement outputs (site data, not source code; see 重构执行.md R-010)
power_data.mdf

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
hardware/smoke_config.local.json
hardware/smoke_result*.json
hardware/smoke_*_result.local.json
