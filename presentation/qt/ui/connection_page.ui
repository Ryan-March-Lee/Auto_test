       <!-- 顶部先留出一段固定空白，页面主体才不会贴到窗口上沿；剩下的富余高度再按
            2:1 分给上下留白：两个上留白 + 一个下留白。QUiLoader 不读取 Designer 的
            layout stretch 属性，因此用等价的弹性项组合表达 addStretch(2)/addStretch(1)。 -->
       <item>
        <spacer name="topSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
